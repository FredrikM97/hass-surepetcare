{
  "name": "Python Dev Container",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "GitHub.copilot"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.env.linux": {
          "PATH": "/home/vscode/.venv/bin:${env:PATH}"
        }
      }
    }
  },

  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,readonly"
  ],
  "postCreateCommand": "git config --global --unset-all core.hooksPath || true && git config --local --unset-all core.hooksPath || true && uv sync --group dev --python /usr/local/bin/python && uv run pre-commit install --install-hooks"
}